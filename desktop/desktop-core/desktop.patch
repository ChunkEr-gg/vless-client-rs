diff --git a/cmd/sing-box/cmd_run.go b/cmd/sing-box/cmd_run.go
index fecd99a..a81755f 100644
--- a/cmd/sing-box/cmd_run.go
+++ b/cmd/sing-box/cmd_run.go
@@ -4,0 +5,2 @@ import (
+	"fmt"
+	"github.com/sagernet/sing-box/common/trafficcontrol"
@@ -141,0 +144 @@ func create(options option.Options) (*box.Box, context.CancelFunc, error) {
+		DesktopTraffic:             os.Getenv("RK_DESKTOP_EVENTS") == "1",
@@ -170,0 +174,24 @@ func create(options option.Options) (*box.Box, context.CancelFunc, error) {
+	if os.Getenv("RK_DESKTOP_EVENTS") == "1" {
+		inbound, ok := instance.Inbound().Get("local")
+		bound, isSOCKS := inbound.(interface{ DesktopAddress() string })
+		if !ok || !isSOCKS {
+			cancel()
+			instance.Close()
+			return nil, nil, E.New("missing desktop SOCKS inbound")
+		}
+		fmt.Fprintln(os.Stdout, "READY", bound.DesktopAddress())
+		traffic := service.PtrFromContext[trafficcontrol.Manager](ctx)
+		go func() {
+			tick := time.NewTicker(time.Second)
+			defer tick.Stop()
+			for {
+				select {
+				case <-ctx.Done():
+					return
+				case <-tick.C:
+					up, down := traffic.Total()
+					fmt.Fprintln(os.Stdout, "BYTES", up, down)
+				}
+			}
+		}()
+	}
