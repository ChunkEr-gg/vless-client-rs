diff --git a/common/tls/std_client.go b/common/tls/std_client.go
index 80fa6cb..c365fbc 100644
--- a/common/tls/std_client.go
+++ b/common/tls/std_client.go
@@ -9,0 +10 @@ import (
+	"encoding/hex"
@@ -145,0 +147,17 @@ func newSTDClient(ctx context.Context, logger logger.ContextLogger, serverAddres
+	if options.CertificateLeafSHA256 != "" {
+		pin, err := hex.DecodeString(options.CertificateLeafSHA256)
+		if err != nil || len(pin) != sha256.Size {
+			return nil, E.New("invalid TLS leaf pin")
+		}
+		tlsConfig.InsecureSkipVerify = true // Authenticate the presented leaf against the configured digest.
+		tlsConfig.VerifyConnection = func(state tls.ConnectionState) error {
+			if len(state.PeerCertificates) == 0 {
+				return E.New("missing TLS certificate")
+			}
+			actual := sha256.Sum256(state.PeerCertificates[0].Raw)
+			if !bytes.Equal(actual[:], pin) {
+				return E.New("TLS leaf certificate pin mismatch")
+			}
+			return nil
+		}
+	}
